{
  "__inputs": [
    {
      "name": "DS_CLICKHOUSE",
      "label": "ClickHouse",
      "type": "datasource",
      "pluginId": "grafana-clickhouse-datasource",
      "pluginName": "ClickHouse"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "grafana-clickhouse-datasource",
      "name": "ClickHouse"
    }
  ],
  "uid": "efzksbjjosidcd",
  "title": "Pipeline Ops",
  "tags": [
    "indo-realtime-monitor",
    "ops"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Record baru per source",
      "description": "Jumlah record baru per 5 menit (skala log). Celah >10 menit = pipeline tidak berjalan.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT toStartOfFiveMinutes(run_at) AS time, source, sum(new_records) AS new_records\nFROM ingest_runs WHERE $__timeFilter(run_at)\nGROUP BY time, source ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.source}",
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 50,
            "showPoints": "never",
            "pointSize": 4,
            "insertNulls": 600000,
            "spanNulls": false,
            "scaleDistribution": {
              "type": "log",
              "log": 10
            },
            "axisSoftMin": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency fetch",
      "description": "Rata-rata durasi fetch per source (skala log).",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT toStartOfFiveMinutes(run_at) AS time, source, avg(latency_ms) AS latency_ms\nFROM ingest_runs WHERE $__timeFilter(run_at)\nGROUP BY time, source ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.source}",
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "auto",
            "pointSize": 4,
            "insertNulls": 600000,
            "spanNulls": false,
            "scaleDistribution": {
              "type": "log",
              "log": 10
            },
            "axisSoftMin": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Status DQ",
      "description": "Hasil check DQ terbaru per source (1 jam terakhir). Urutan: fail, warn, pass.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 16
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT source, check_name,\n       argMax(status, checked_at) AS status,\n       round(argMax(value, checked_at), 1) AS value,\n       argMax(detail, checked_at) AS detail,\n       max(checked_at) AS checked_at\nFROM dq_results\nWHERE checked_at > now() - INTERVAL 1 HOUR\nGROUP BY source, check_name\nORDER BY multiIf(status = 'fail', 0, status = 'warn', 1, 2), source, check_name"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "pass": {
                  "color": "green",
                  "index": 0,
                  "text": "pass"
                },
                "warn": {
                  "color": "yellow",
                  "index": 1,
                  "text": "warn"
                },
                "fail": {
                  "color": "red",
                  "index": 2,
                  "text": "fail"
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "source"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "check_name"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "value"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "checked_at"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              },
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    }
  ]
}